#!/usr/bin/env bash
#
# {{.SiteName}} — Claude Code 一键接入脚本
# 用法（控制台会生成带一次性令牌的完整命令）：
#   curl -fsSL {{.BaseURL}}/oneclick/setup.sh | bash -s -- <setup-token>
#
# 脚本做四件事：兑换令牌取密钥 → 检测/安装 Claude Code →
# 合并写 ~/.claude/settings.json（原有配置保留，写前自动备份）→ 验证连接并回执。
set -u

BASE_URL="{{.BaseURL}}"
SITE_NAME="{{.SiteName}}"
TOKEN="${1:-${HOPBASE_SETUP_TOKEN:-}}"

info() { printf '\033[1;34m•\033[0m %s\n' "$1"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$1"; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$1" >&2; exit 1; }

[ -n "$TOKEN" ] || die "缺少接入令牌：请回控制台复制完整命令执行"
command -v curl >/dev/null 2>&1 || die "未找到 curl，请先安装 curl 后重试"

printf '\n\033[1m%s · Claude Code 一键接入\033[0m\n\n' "$SITE_NAME"

# ── 1/4 兑换接入配置（令牌只能使用一次，15 分钟内有效）──────────────────
info "获取接入配置..."
resp="$(curl -fsS -X POST --data-urlencode "token=$TOKEN" "$BASE_URL/oneclick/exchange")" \
  || die "令牌兑换失败：令牌可能已过期或已被使用，请回控制台重新生成命令"

API_KEY=""
KEY_NAME=""
while IFS='=' read -r k v; do
  case "$k" in
    api_key)  API_KEY="$v" ;;
    key_name) KEY_NAME="$v" ;;
    base_url) [ -n "$v" ] && BASE_URL="$v" ;;
  esac
done <<< "$resp"
[ -n "$API_KEY" ] || die "兑换响应异常，请联系管理员"
ok "已获取密钥${KEY_NAME:+（$KEY_NAME）}"

# ── 2/4 检测 / 安装 Claude Code ────────────────────────────────────────
if command -v claude >/dev/null 2>&1; then
  ok "已检测到 Claude Code"
else
  info "未检测到 Claude Code，正在通过官方脚本安装..."
  curl -fsSL https://claude.ai/install.sh | bash \
    || die "Claude Code 安装失败：可先手动安装（npm install -g @anthropic-ai/claude-code）后重跑本命令"
  export PATH="$HOME/.local/bin:$PATH"
  if command -v claude >/dev/null 2>&1; then
    ok "Claude Code 安装完成"
  else
    info "Claude Code 已安装。若稍后终端提示找不到 claude 命令，请重新打开终端"
  fi
fi

# ── 3/4 写入配置（只合并 env 两个键，settings.json 其余内容原样保留）────
CLAUDE_DIR="$HOME/.claude"
SETTINGS="$CLAUDE_DIR/settings.json"
mkdir -p "$CLAUDE_DIR"
if [ -s "$SETTINGS" ]; then
  BACKUP="$SETTINGS.bak.$(date +%Y%m%d%H%M%S)"
  cp "$SETTINGS" "$BACKUP"
  info "已备份原配置到 $BACKUP"
fi

merge_with_python() {
  command -v python3 >/dev/null 2>&1 || return 1
  SETTINGS_PATH="$SETTINGS" NEW_BASE_URL="$BASE_URL" NEW_API_KEY="$API_KEY" python3 - <<'PYEOF'
import json, os, sys
path = os.environ["SETTINGS_PATH"]
data = {}
if os.path.exists(path):
    with open(path, encoding="utf-8") as f:
        content = f.read().strip()
    if content:
        try:
            data = json.loads(content)
        except Exception:
            sys.exit(3)
if not isinstance(data, dict):
    sys.exit(3)
env = data.get("env")
if not isinstance(env, dict):
    env = {}
env["ANTHROPIC_BASE_URL"] = os.environ["NEW_BASE_URL"]
env["ANTHROPIC_AUTH_TOKEN"] = os.environ["NEW_API_KEY"]
data["env"] = env
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
    f.write("\n")
PYEOF
}

merge_with_node() {
  command -v node >/dev/null 2>&1 || return 1
  SETTINGS_PATH="$SETTINGS" NEW_BASE_URL="$BASE_URL" NEW_API_KEY="$API_KEY" node <<'NODEEOF'
const fs = require("fs");
const path = process.env.SETTINGS_PATH;
let data = {};
if (fs.existsSync(path)) {
  const content = fs.readFileSync(path, "utf8").trim();
  if (content) {
    try { data = JSON.parse(content); } catch { process.exit(3); }
  }
}
if (typeof data !== "object" || data === null || Array.isArray(data)) process.exit(3);
if (typeof data.env !== "object" || data.env === null || Array.isArray(data.env)) data.env = {};
data.env.ANTHROPIC_BASE_URL = process.env.NEW_BASE_URL;
data.env.ANTHROPIC_AUTH_TOKEN = process.env.NEW_API_KEY;
fs.writeFileSync(path, JSON.stringify(data, null, 2) + "\n");
NODEEOF
}

write_fresh() {
  cat > "$SETTINGS" <<JSONEOF
{
  "env": {
    "ANTHROPIC_BASE_URL": "$BASE_URL",
    "ANTHROPIC_AUTH_TOKEN": "$API_KEY"
  }
}
JSONEOF
}

if [ ! -s "$SETTINGS" ]; then
  write_fresh
  ok "已写入 $SETTINGS"
elif merge_with_python; then
  ok "已更新 $SETTINGS（原有配置已保留）"
elif merge_with_node; then
  ok "已更新 $SETTINGS（原有配置已保留）"
else
  info "本机缺少 python3/node，无法自动合并已有配置。请手动把以下两项加入 $SETTINGS 的 env 字段："
  printf '\n    "ANTHROPIC_BASE_URL": "%s",\n    "ANTHROPIC_AUTH_TOKEN": "%s"\n\n' "$BASE_URL" "$API_KEY"
  die "配置未完成"
fi

# ── 4/4 验证连接并回执 ────────────────────────────────────────────────
info "验证网关连接..."
if curl -fsS -H "Authorization: Bearer $API_KEY" "$BASE_URL/v1/usage" >/dev/null 2>&1; then
  ok "网关连接验证通过"
  curl -fsS -X POST --data-urlencode "token=$TOKEN" "$BASE_URL/oneclick/verify" >/dev/null 2>&1 || true
else
  die "网关连接验证失败：配置已写入，但用密钥请求网关未成功。请检查网络后直接运行 claude 重试，或联系管理员"
fi

printf '\n'
ok "接入完成！打开一个新终端，输入 claude 即可开始使用"
printf '  · 网关地址：%s\n  · 配置文件：%s\n' "$BASE_URL" "$SETTINGS"
