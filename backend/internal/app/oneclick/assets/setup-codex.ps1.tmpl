# {{.SiteName}} — Codex CLI 一键接入脚本（Windows PowerShell）
# 用法（控制台会生成带一次性令牌的完整命令）：
#   $env:HOPBASE_SETUP_TOKEN='<setup-token>'; irm {{.BaseURL}}/oneclick/setup-codex.ps1 | iex
#
# 注意：脚本经 iex 在当前会话执行，失败用 throw 终止，绝不调用 exit（会关掉用户的终端窗口）。

$ErrorActionPreference = 'Stop'

$BaseUrl  = '{{.BaseURL}}'
$SiteName = '{{.SiteName}}'
$Token    = $env:HOPBASE_SETUP_TOKEN

function Write-Info($msg) { Write-Host "- $msg" -ForegroundColor Cyan }
function Write-Ok($msg)   { Write-Host "√ $msg" -ForegroundColor Green }
function Fail($msg)       { throw $msg }

try {
    if (-not $Token) { Fail '缺少接入令牌：请回控制台复制完整命令执行' }

    Write-Host ''
    Write-Host "$SiteName · Codex CLI 一键接入" -ForegroundColor White
    Write-Host ''

    # ── 1/4 兑换接入配置（令牌只能使用一次，15 分钟内有效）────────────
    Write-Info '获取接入配置...'
    try {
        $resp = Invoke-RestMethod -Method Post -Uri "$BaseUrl/oneclick/exchange" -Body @{ token = $Token }
    } catch {
        Fail '令牌兑换失败：令牌可能已过期或已被使用，请回控制台重新生成命令'
    }
    $cfg = @{}
    foreach ($line in ($resp -split "`r?`n")) {
        $i = $line.IndexOf('=')
        if ($i -gt 0) { $cfg[$line.Substring(0, $i)] = $line.Substring($i + 1).Trim() }
    }
    $ApiKey = $cfg['api_key']
    if (-not $ApiKey) { Fail '兑换响应异常，请联系管理员' }
    if ($cfg['base_url']) { $BaseUrl = $cfg['base_url'] }
    Write-Ok '已获取密钥'

    # ── 2/4 检测 / 安装 Codex CLI ────────────────────────────────────
    if (Get-Command codex -ErrorAction SilentlyContinue) {
        Write-Ok '已检测到 Codex CLI'
    } elseif (Get-Command npm -ErrorAction SilentlyContinue) {
        Write-Info '未检测到 Codex CLI，正在通过 npm 安装...'
        try {
            npm install -g @openai/codex
            Write-Ok 'Codex CLI 安装完成'
        } catch {
            Fail 'Codex CLI 安装失败：可手动执行 npm install -g @openai/codex 后重跑本命令'
        }
    } else {
        Write-Info '未检测到 codex 与 npm，跳过自动安装（配置仍会写入）。请稍后安装 Node.js 后执行 npm install -g @openai/codex'
    }

    # ── 3/4 写入配置（config.toml 整文件重写，原文件先备份；auth.json 同）──
    $codexDir = Join-Path $env:USERPROFILE '.codex'
    $configFile = Join-Path $codexDir 'config.toml'
    $authFile = Join-Path $codexDir 'auth.json'
    New-Item -ItemType Directory -Force -Path $codexDir | Out-Null
    $stamp = Get-Date -Format yyyyMMddHHmmss
    foreach ($f in @($configFile, $authFile)) {
        if ((Test-Path $f) -and ((Get-Content $f -Raw).Trim())) {
            Copy-Item $f "$f.bak.$stamp"
            Write-Info "已备份 $f -> $f.bak.$stamp"
        }
    }

    # provider 键名只保留 TOML 裸键安全字符，避免站点名带空格/符号写坏配置
    $providerKey = ($SiteName -replace '[^A-Za-z0-9_-]', '')
    if (-not $providerKey) { $providerKey = 'hopbase' }

    $configToml = @"
model_provider = "$providerKey"
model = "gpt-5.5"
review_model = "gpt-5.5"
model_reasoning_effort = "xhigh"
disable_response_storage = true
network_access = "enabled"

[model_providers.$providerKey]
name = "$SiteName"
base_url = "$BaseUrl/v1"
wire_api = "responses"
requires_openai_auth = true

[features]
goals = true
"@
    Set-Content -Path $configFile -Value $configToml -Encoding UTF8
    $authJson = @"
{
  "OPENAI_API_KEY": "$ApiKey"
}
"@
    Set-Content -Path $authFile -Value $authJson -Encoding UTF8
    Write-Ok "已写入 $configFile 与 $authFile"

    # ── 4/4 验证连接并回执 ────────────────────────────────────────────
    Write-Info '验证网关连接...'
    try {
        Invoke-RestMethod -Uri "$BaseUrl/v1/usage" -Headers @{ Authorization = "Bearer $ApiKey" } | Out-Null
        Write-Ok '网关连接验证通过'
        try { Invoke-RestMethod -Method Post -Uri "$BaseUrl/oneclick/verify" -Body @{ token = $Token } | Out-Null } catch {}
    } catch {
        Fail '网关连接验证失败：配置已写入，但用密钥请求网关未成功。请检查网络后直接运行 codex 重试，或联系管理员'
    }

    Write-Host ''
    Write-Ok '接入完成！打开一个新终端，输入 codex 即可开始使用'
    Write-Host "  · 网关地址：$BaseUrl/v1"
    Write-Host "  · 配置文件：$configFile"
} catch {
    Write-Host "× $($_.Exception.Message)" -ForegroundColor Red
} finally {
    Remove-Item Env:HOPBASE_SETUP_TOKEN -ErrorAction SilentlyContinue
}
